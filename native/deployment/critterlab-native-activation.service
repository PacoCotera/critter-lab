[Unit]
Description=Critter Lab accepted-state recovery manager
After=local-fs.target
Before=critterlab-native-gateway.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/critterlab-native-updater/activation_manager.py recover
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
