[Unit]
Description=Critter Lab fail-closed local gateway
After=local-fs.target

[Service]
Type=simple
User=REPLACE_GATEWAY_NONZERO_UID
Group=REPLACE_GATEWAY_NONZERO_GID
ExecStart=/usr/bin/python3 /usr/local/lib/critterlab-native-updater/deployment_gateway.py --gate /run/critterlab-native-gateway/gate.json --origin-port REPLACE_RUNTIME_LOOPBACK_PORT --listen-port REPLACE_GATEWAY_LOOPBACK_PORT --canonical-host REPLACE_PUBLIC_HOST --trusted-gate-uid 0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
